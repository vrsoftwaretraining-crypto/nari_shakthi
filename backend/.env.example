# Developed by Codesoftwares
# Names only. Put real values in the host's secret manager.
APP_ENV=production
PORT=8080
DATABASE_URL=postgres://user:pass@host:5432/nari_shakthi
TOKEN_SIGNING_SECRET=SET_IN_SECRET_MANAGER
MEDIA_DIR=/var/lib/nari_shakthi/media
# Password reset email (SMTP). Without these, production cannot send reset codes.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=SET_IN_SECRET_MANAGER
SMTP_PASS=SET_IN_SECRET_MANAGER
SMTP_FROM=no-reply@your-domain
# Razorpay online payments (use rzp_test_ keys while testing). Leave empty to disable the "Pay online" button.
RAZORPAY_KEY_ID=SET_IN_SECRET_MANAGER
RAZORPAY_KEY_SECRET=SET_IN_SECRET_MANAGER
RAZORPAY_WEBHOOK_SECRET=SET_IN_SECRET_MANAGER
# Website (Flutter web) origin(s) allowed to call this API, comma separated. Required in production.
CORS_ORIGINS=https://www.your-domain.com
